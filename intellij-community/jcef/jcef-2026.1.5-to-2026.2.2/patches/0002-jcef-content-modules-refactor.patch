+          super.paint(g)
+          super.paintBorder(g)
+        }
+      }.also {
+        UIUtil.setNotOpaqueRecursively(it)
+        val adjustedSize = Dimension(size.width + 2, size.height + 2)
+        it.minimumSize = adjustedSize
+        it.preferredSize = adjustedSize
+      }
+    }

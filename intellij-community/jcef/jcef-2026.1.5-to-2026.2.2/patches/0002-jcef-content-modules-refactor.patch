diff --git a/platform/platform-impl/internal/jcef/src/com/intellij/internal/jcef/test/detailed/dialog/DownloadDialog.java b/platform/platform-impl/internal/jcef/src/com/intellij/internal/jcef/test/detailed/dialog/DownloadDialog.java
new file mode 100644
index 000000000000..3e361311f676

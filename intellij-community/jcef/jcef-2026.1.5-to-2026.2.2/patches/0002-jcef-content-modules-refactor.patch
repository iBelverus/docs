+
+  fun createContent() = JBPanel<JBPanel<*>>().apply {
+    layout = BorderLayout()
+
+    if (!JBCefApp.isSupported()) {
+      val label = JBLabel("JCef not supported")
+      add(label, BorderLayout.CENTER)

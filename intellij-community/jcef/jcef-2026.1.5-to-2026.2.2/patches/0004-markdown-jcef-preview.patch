diff --git a/plugins/markdown/test/src/org/intellij/plugins/markdown/extensions/MarkdownCodeSpanConfigurationRunnerTest.kt b/plugins/markdown/test/src/org/intellij/plugins/markdown/extensions/MarkdownCodeSpanConfigurationRunnerTest.kt

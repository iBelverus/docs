+            </style>
+        </head>
+        <body>
+            <div class="container">
+                <h1>🔥 NPE REPRODUCTION STRESS TEST 🔥</h1>
+                <div id="stats">
+                    <div>Queries Sent: <span id="sent">0</span></div>
+                    <div>Success: <span id="success">0</span></div>
+                    <div>Errors: <span id="errors">0</span></div>
+                    <div>In Flight: <span id="inflight">0</span></div>
+                </div>
+                <div id="log"></div>

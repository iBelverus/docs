+    client_.addLoadHandler(new CefLoadHandlerAdapter() {
+      @Override
+      public void onLoadingStateChange(CefBrowser browser, boolean isLoading,
+                                       boolean canGoBack, boolean canGoForward) {
+        SwingUtilities.invokeLater(() -> {

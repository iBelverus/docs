+                    if (newWord != null) {
+                        browser.replaceMisspelling(newWord);
+                        return true;
+                    }
+                }
+                return false;
+        }
+    }
+
+    @Override
+    public void onContextMenuDismissed(CefBrowser browser, CefFrame frame) {
+        suggestions_.clear();
+    }
+}
